# ===== OBRIGATÓRIAS (servidor principal) =====
OPENAI_API_KEY=sk-proj-xxxxx
WASENDERAPI_TOKEN=seu-token-wasenderapi
WEBHOOK_VERIFY_TOKEN=seu-verify-token

# ===== RECOMENDADAS =====
WASENDERAPI_BASE_URL=https://www.wasenderapi.com/api
WASENDERAPI_WEBHOOK_SECRET=seu-webhook-secret

# ===== OPCIONAIS (webhook) =====
# PORT=8080                    # Railway define automaticamente
# WEBHOOK_API_KEY=             # Header x-api-key extra
# PHONE_NUMBER_ID=             # Não obrigatório para envio
# API_ACCESS_TOKEN=            # Fallback para WASENDERAPI_TOKEN

# ===== BANCO DE DADOS =====
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ===== AUTENTICAÇÃO (dashboard) =====
# JWT_SECRET=segredo-jwt-forte

# ===== ADMIN =====
# ADMIN_PHONES=5511999999999,5511888888888

# ===== INTEGRAÇÕES OPCIONAIS =====
# FEEGOW_TOKEN=token-feegow
# GOOGLE_SERVICE_ACCOUNT_JSON=path/to/credentials.json
# GOOGLE_CALENDAR_ID=calendar-id@group.calendar.google.com
# UAZAPI_TOKEN=token-uazapi-legado
