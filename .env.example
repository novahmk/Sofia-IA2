# ============================================================
# SOFIA IA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais.
# ============================================================

# ── Servidor principal (index.js) ────────────────────────────
PORT=3000
NODE_ENV=production

# ── Dashboard seguro (dashboard-server.js) ───────────────────
# Porta HTTPS do servidor de dashboard
DASHBOARD_PORT=8443

# Domínios permitidos no CORS (separados por vírgula, sem protocolo)
# Exemplo: localhost,sofia-ia2-production.up.railway.app
DASHBOARD_DOMAIN=localhost,sofia-ia2-production.up.railway.app

# ── JWT ──────────────────────────────────────────────────────
# Access token secret — gere com: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
# Ou: openssl rand -hex 64
JWT_SECRET=SUBSTITUA_POR_64_CHARS_HEX_ALEATORIO_AQUI_EXEMPLO_abc123

# Refresh token secret — deve ser DIFERENTE do JWT_SECRET
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRO_64_CHARS_HEX_ALEATORIO_AQUI_EXEMPLO_def456

# ── Criptografia AES-256 ─────────────────────────────────────
# Chave de 32 bytes (64 chars hex) para criptografia AES-256-GCM
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=SUBSTITUA_POR_32_BYTES_HEX_64_CHARS_AQUI_EXEMPLO_0123456789abcdef

# Criptografar respostas de dados sensíveis (true/false)
ENCRYPT_RESPONSES=false

# ── TLS/HTTPS ────────────────────────────────────────────────
# Em produção (Railway): forneça o certificado e chave em base64 ou path
# Deixe em branco em desenvolvimento (certificado auto-assinado será gerado)
#
# Para codificar em base64: base64 -w 0 cert.pem
# TLS_CERT=<conteúdo PEM do certificado em base64 ou path absoluto>
# TLS_KEY=<conteúdo PEM da chave privada em base64 ou path absoluto>
TLS_CERT=
TLS_KEY=

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── UAZAPI (WhatsApp) ────────────────────────────────────────
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_TOKEN=seu-token-uazapi

# ── Feegow (Agendamentos) ────────────────────────────────────
FEEGOW_TOKEN=seu-token-feegow

# ── Banco de dados ───────────────────────────────────────────
# PostgreSQL connection string (Railway injeta automaticamente)
# Deixe em branco para usar cache em memória
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Google Calendar ──────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=path/para/service-account.json
GOOGLE_CALENDAR_ID=seu-email@gmail.com

# ── Admin ────────────────────────────────────────────────────
# Números de telefone admin separados por vírgula (sem +, com DDI)
ADMIN_PHONES=5511999999999,5511888888888
