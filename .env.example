# ═══════════════════════════════════════════════════════════
# SOFIA IA — Quality Hair
# Variáveis de ambiente para Railway / .env local
# ═══════════════════════════════════════════════════════════

# ===== OBRIGATÓRIAS =====
OPENAI_API_KEY=sk-proj-xxxxx                         # Obrigatória para IA principal + roteador contextual de intenções
WASENDERAPI_TOKEN=seu-token-wasenderapi               # Token da WASenderAPI para envio de msgs
WASENDERAPI_WEBHOOK_SECRET=seu-webhook-secret         # Segredo p/ validar X-Webhook-Signature

# ===== RECOMENDADAS =====
WASENDERAPI_BASE_URL=https://www.wasenderapi.com/api  # URL base da WASenderAPI
WEBHOOK_VERIFY_TOKEN=seu-verify-token                 # Token p/ verificação GET /webhook

# ===== SERVIDOR =====
# PORT=8080                    # Railway injeta automaticamente — NÃO definir manualmente
# WEBHOOK_PORT=3000            # Fallback se PORT não existir (index.js)

# ===== AUTENTICAÇÃO (dashboard) =====
# JWT_SECRET=segredo-jwt-forte

# ===== ADMIN =====
# ADMIN_PHONES=5511999999999,5511888888888   # Números autorizados a usar comandos de controle

# ===== BANCO DE DADOS =====
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ===== INTEGRAÇÕES OPCIONAIS =====
# OPENAI_ROUTER_MODEL=gpt-4o-mini                    # Modelo do roteador contextual de intenções
# FEEGOW_TOKEN=token-feegow
# GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=seu-client-secret
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8080
# GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_OAUTH_TOKEN_FILE=google-oauth-token.json
# GOOGLE_SERVICE_ACCOUNT_FILE=serviceAccountKey.json
# GOOGLE_SERVICE_ACCOUNT_JSON=path/to/credentials.json

# ===== FALLBACKS / LEGADO =====
# API_ACCESS_TOKEN=            # Fallback para WASENDERAPI_TOKEN
